# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgres://chatuser:chatpass@localhost:5432/realtimechat
# Production (Neon / Supabase — use the connection string from your dashboard):
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev (Docker redis-stack):
REDIS_URL=redis://localhost:6379
# Production (Upstash — use the rediss:// URL from your Upstash dashboard):
# REDIS_URL=rediss://:password@host:port

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev:
CLIENT_ORIGIN=http://localhost:5173
# Production (your Vercel URL):
# CLIENT_ORIGIN=https://your-app.vercel.app

# ── Cloudinary (file / image uploads) ────────────────────────────────────────
# Get these from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
